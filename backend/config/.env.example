# 提供商适配器：deepseek / mimo / openai_compatible（通用 OpenAI 兼容）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 思考开关：enabled / disabled；留空采用服务端默认。
# 由适配器转换：DeepSeek / MiMo Chat → thinking.type；Responses → reasoning.effort（high / none）。
# 通用适配器：Chat → reasoning_effort；Responses → reasoning.effort。
LLM_THINKING_TYPE=disabled
# 首选接口：chat_completions / responses。能力探测、人设生成使用所选接口。
# Browser Use 与 OASIS/CAMEL 仅支持 Chat，只对该模块降级并记录原因；提供商、模型、思考和并发设置保留。
LLM_API=responses
# DeepSeek Chat 不支持严格 JSON Schema 输出。JSON Object 仅保证 JSON 格式，
# 必须配合提示词约束、本地校验与修正重试，不能当作严格结构化输出。
# MiMo 的 Chat / Responses 均使用 JSON Object，不声明严格 JSON Schema 保证。
# MiMo 配置示例：LLM_PROVIDER=mimo、LLM_MODEL=mimo-v2.6-pro，
# LLM_BASE_URL=https://api.xiaomimimo.com/v1；Token Plan 使用套餐提供的端点。
# 同一配置供两个 Python 环境读取；所有模型调用共享模型上限，浏览 Agent 上限为 min(两者)。
# 人设生成、讨论等不使用浏览器的模块只受模型上限限制。运行期间修改上限需先停止现有进程。
LLM_MAX_CONCURRENCY=10
BROWSER_MAX_CONCURRENCY=1
STEEL_API_KEY=

# 阶段 2：有登录需求时配置说明书声明的测试账号，角色名转大写，非字母数字替换为下划线。
# 例如 free_user；new_visitor 不需要账号。这些值只通过 Browser Use 的域名限定 sensitive_data 注入。
TEST_ACCOUNT_FREE_USER_USERNAME=
TEST_ACCOUNT_FREE_USER_PASSWORD=

# 阶段 0 只读取网页，默认使用无登录的示例页面。
PROBE_URL=https://example.com
PROBE_TIMEZONE=Asia/Shanghai
