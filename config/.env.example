# 提供商适配器：deepseek（当前使用）/ openai_compatible（通用 OpenAI 兼容）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 思考开关：enabled / disabled；留空采用服务端默认。
# 由适配器转换：DeepSeek Chat → thinking.type；Responses → reasoning.effort（high / none）。
# 通用适配器：Chat → reasoning_effort；Responses → reasoning.effort。
LLM_THINKING_TYPE=disabled
# 首选接口：chat_completions / responses。能力探测、人设生成使用所选接口。
# Browser Use 与 OASIS/CAMEL 仅支持 Chat，只对该模块降级并记录原因；提供商、模型、思考和并发设置保留。
LLM_API=responses
# DeepSeek Chat 不支持严格 JSON Schema 输出。JSON Object 仅保证 JSON 格式，
# 必须配合提示词约束、本地校验与修正重试，不能当作严格结构化输出。
# 同一配置供两个 Python 环境读取；所有模型调用共享模型上限，浏览 Agent 上限为 min(两者)。
# 人设生成、讨论等不使用浏览器的模块只受模型上限限制。运行期间修改上限需先停止现有进程。
LLM_MAX_CONCURRENCY=10
BROWSER_MAX_CONCURRENCY=1
STEEL_API_KEY=

# 阶段 0 只读取网页，默认使用无登录的示例页面。
PROBE_URL=https://example.com
PROBE_TIMEZONE=Asia/Shanghai
