LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
# 当前厂商的 thinking.type：enabled / disabled；留空不发送，采用服务端默认。
LLM_THINKING_TYPE=disabled
# 接口类型：chat_completions（默认）/ responses。能力探测和人设生成按此调用；
# Browser Use 与 OASIS 不支持 Responses API，选 responses 时这两部分降级为 Chat Completions。
LLM_API=chat_completions
STEEL_API_KEY=

# 阶段 0 只读取网页，默认使用无登录的示例页面。
PROBE_URL=https://example.com
PROBE_TIMEZONE=Asia/Shanghai
